<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal NativeActivity manifest: the whole game is native C, so the only Java
  is GloryOfRomeActivity (immersive mode + display-cutout insets). Android loads
  libgloryofrome.so directly via android.app.NativeActivity (the
  "android.app.lib_name" meta-data names the .so without its "lib" prefix or
  ".so" suffix).

  Landscape-locked: the pack declares a fixed 800x532 buffer (render.native_w /
  native_h in game.json), which has no portrait form.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.danheskett.gloryofrome">

    <!-- versionCode/versionName are intentionally absent: aapt/aapt2
         - -version-code/- -version-name only inject when the manifest has none,
         so hardcoding them here would silently pin every Play upload to 1. -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />

    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- No android:icon yet: the launcher icon has to be drawn (the pack's own
         art is generated, and this project does not crop or composite that),
         so the system default stands in until one exists. Add
         android:icon="@mipmap/ic_launcher" with res/mipmap-*/ when it does. -->
    <application android:label="Glory of Rome"
                 android:hasCode="true"
                 android:allowBackup="false">

        <!-- Apps targeting API 36 have android:screenOrientation ignored on any
             display >= sw600dp: tablets and unfolded foldables get a resizable
             window whatever the activity asks for. The layout here is a fixed
             landscape buffer, so this property opts back into the pre-36
             behaviour and keeps the lock everywhere.

             This is a deferral, not a fix: Google removes the opt-out at API 37,
             at which point the shell needs a real large-screen layout. -->
        <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                  android:value="true" />

        <activity android:name="com.danheskett.gloryofrome.GloryOfRomeActivity"
                  android:label="Glory of Rome"
                  android:screenOrientation="landscape"
                  android:configChanges="orientation|keyboardHidden|screenSize"
                  android:exported="true"
                  android:theme="@style/GloryOfRomeTheme">

            <!-- Names the native library (libgloryofrome.so) NativeActivity loads. -->
            <meta-data android:name="android.app.lib_name" android:value="gloryofrome" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
