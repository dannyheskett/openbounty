diff --git a/src/platforms/rcore_android.c b/src/platforms/rcore_android.c
index f501fba..a48a375 100644
--- a/src/platforms/rcore_android.c
+++ b/src/platforms/rcore_android.c
@@ -970,7 +970,78 @@ static int InitGraphicsDevice(void)
     }
 
     // Get an appropriate EGL framebuffer configuration
-    eglChooseConfig(platform.device, framebufferAttribs, &platform.config, 1, &numConfigs);
+    //
+    // NOTE(openbounty): the return of eglChooseConfig() and numConfigs were
+    // both ignored here. When NO configuration matches the request,
+    // platform.config keeps whatever it held and eglCreateContext() fails with
+    // EGL_BAD_CONFIG, saying nothing about which attribute was impossible.
+    //
+    // Two attributes are worth giving up rather than failing over: the 24-bit
+    // depth buffer (this game is 2D, and plenty of GL implementations offer
+    // only 16, or none) and 8-bit colour (some offer 5/6/5 only -- the Android
+    // emulator's software EGL advertises seven configurations, none of them
+    // RGB888). Ask for the best first and walk down, then say what was taken.
+    {
+        static const EGLint colorDepth[][4] = {
+            // R, G, B, depth
+            { 8, 8, 8, 24 }, { 8, 8, 8, 16 }, { 8, 8, 8, 0 },
+            { 5, 6, 5, 24 }, { 5, 6, 5, 16 }, { 5, 6, 5, 0 },
+        };
+        EGLint attribs[sizeof(framebufferAttribs)/sizeof(EGLint)];
+
+        for (unsigned int c = 0; c < sizeof(colorDepth)/sizeof(colorDepth[0]); c++)
+        {
+            for (unsigned int i = 0; i < sizeof(attribs)/sizeof(attribs[0]); i++) attribs[i] = framebufferAttribs[i];
+            for (unsigned int i = 0; attribs[i] != EGL_NONE; i += 2)
+            {
+                if (attribs[i] == EGL_RED_SIZE) attribs[i + 1] = colorDepth[c][0];
+                else if (attribs[i] == EGL_GREEN_SIZE) attribs[i + 1] = colorDepth[c][1];
+                else if (attribs[i] == EGL_BLUE_SIZE) attribs[i + 1] = colorDepth[c][2];
+                else if (attribs[i] == EGL_DEPTH_SIZE) attribs[i + 1] = colorDepth[c][3];
+            }
+
+            numConfigs = 0;
+            if (!eglChooseConfig(platform.device, attribs, &platform.config, 1, &numConfigs))
+            {
+                TRACELOG(LOG_WARNING, "DISPLAY: eglChooseConfig failed: 0x%x", eglGetError());
+            }
+
+            if (numConfigs > 0)
+            {
+                TRACELOG(LOG_INFO, "DISPLAY: EGL configuration chosen: RGB %i%i%i, %i-bit depth",
+                         colorDepth[c][0], colorDepth[c][1], colorDepth[c][2], colorDepth[c][3]);
+                break;
+            }
+        }
+
+        if (numConfigs == 0)
+        {
+            // Nothing matched at all: list what the driver does offer, so the
+            // next person reads the answer instead of guessing at it.
+            EGLConfig all[32];
+            EGLint total = 0;
+            eglGetConfigs(platform.device, all, 32, &total);
+            TRACELOG(LOG_WARNING, "DISPLAY: No EGL configuration matched (%i offered; vendor '%s', version '%s', apis '%s')",
+                     total,
+                     eglQueryString(platform.device, EGL_VENDOR),
+                     eglQueryString(platform.device, EGL_VERSION),
+                     eglQueryString(platform.device, EGL_CLIENT_APIS));
+            for (EGLint i = 0; (i < total) && (i < 32); i++)
+            {
+                EGLint r = 0, g = 0, b = 0, a = 0, d = 0, rt = 0, st = 0;
+                eglGetConfigAttrib(platform.device, all[i], EGL_RED_SIZE, &r);
+                eglGetConfigAttrib(platform.device, all[i], EGL_GREEN_SIZE, &g);
+                eglGetConfigAttrib(platform.device, all[i], EGL_BLUE_SIZE, &b);
+                eglGetConfigAttrib(platform.device, all[i], EGL_ALPHA_SIZE, &a);
+                eglGetConfigAttrib(platform.device, all[i], EGL_DEPTH_SIZE, &d);
+                eglGetConfigAttrib(platform.device, all[i], EGL_RENDERABLE_TYPE, &rt);
+                eglGetConfigAttrib(platform.device, all[i], EGL_SURFACE_TYPE, &st);
+                TRACELOG(LOG_WARNING, "DISPLAY:   config %i: RGBA %i%i%i%i depth %i renderable 0x%x surface 0x%x",
+                         i, r, g, b, a, d, rt, st);
+            }
+            return -1;
+        }
+    }
 
     // Set rendering API
     eglBindAPI(EGL_OPENGL_ES_API);
