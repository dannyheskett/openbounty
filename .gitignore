# Build output
build/
dist/*.tar.gz
dist/*.zip
*.o
*.a
*.so
*.exe
*.obj

# Vendored raylib, built from source by scripts/build_raylib_<platform>.sh
third_party/raylib/
third_party/raylib-install*/

# Gameplay recordings written by src/recorder.c into the repo root
*.mp4

# Local agent state. `.claude/*` rather than `.claude/` because git cannot
# re-include a path whose parent directory is excluded, and committed skills
# must stay tracked.
.claude/*
!.claude/skills/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- openbounty only ---
# dist/ is not ignored wholesale: dist/README.txt.in is a tracked source template.

# Emscripten SDK checkout (~1.6 GB). Needed only for the `web` target:
#   git clone https://github.com/emscripten-core/emsdk third_party/emsdk
#   third_party/emsdk/emsdk install latest && third_party/emsdk/emsdk activate latest
third_party/emsdk/

# Dev screenshot captures (V-view auto-save + backtick-key shots). The store
# listings' screenshots are deliberate artefacts and are kept.
screenshots/
!ios/app-store-assets/screenshots/
!android/play-assets/screenshots/
tmp/

# Save data, if ever created in-tree
save.dat
*.sav

# Editor backups of JSON
*.json.bak

# Tooling scratch
.playwright-mcp/
__pycache__/
*.pyc
*:Zone.Identifier

# Local environment variables; may hold credentials
.env

# Mobile build output
*.apk
*.aab
*.ipa

# The original game's files for --extract (KB.EXE and its data). Anchored to
# the top level: unanchored, this also ignored src/legacy/, which is source.
/legacy/

# --- store signing material ---
# Never commit these: the release workflow decodes the Play keystore and the
# Apple distribution certificate from secrets at build time.
*.jks
*.keystore
*.p12
*.mobileprovision
*.p8
*.b64
# ...and the material the signing certificate is built from.
*.key
*.csr
*.cer
*.pem
