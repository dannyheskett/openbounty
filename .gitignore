# Build output
build/
dist/*.tar.gz
dist/*.zip
*.o
*.a
*.so
*.exe
*.obj

# Vendored raylib, built from source by scripts/build_raylib_<platform>.sh
third_party/raylib/
third_party/raylib-install*/

# Gameplay recordings written by src/recorder.c into the repo root
*.mp4

# Local agent state. `.claude/*` rather than `.claude/` because git cannot
# re-include a path whose parent directory is excluded, and committed skills
# must stay tracked.
.claude/*
!.claude/skills/

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- openbounty only ---
# dist/ is not ignored wholesale: dist/README.txt.in is a tracked source template.

# Emscripten SDK checkout (~1.6 GB). Needed only for the `web` target:
#   git clone https://github.com/emscripten-core/emsdk third_party/emsdk
#   third_party/emsdk/emsdk install latest && third_party/emsdk/emsdk activate latest
third_party/emsdk/

# Dev screenshot captures (V-view auto-save + backtick-key shots)
screenshots/
tmp/

# Save data, if ever created in-tree
save.dat
*.sav

# Splicer backup (created by tools/splice_overlays.c)
*.json.bak

# Tooling scratch
.playwright-mcp/
__pycache__/
*.pyc
*:Zone.Identifier

# Local Claude Code harness state (session locks, scheduled tasks).
.claude/
